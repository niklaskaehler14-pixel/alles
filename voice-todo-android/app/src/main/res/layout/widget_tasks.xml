<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_header" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
            <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_today" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/widget_text" />
            <TextView android:id="@+id/widget_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_mic" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:src="@drawable/ic_widget_mic" android:contentDescription="@string/shortcut_voice_long" />
        <ImageView android:id="@+id/widget_add" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:src="@drawable/ic_widget_add" android:contentDescription="@string/widget_add" />
    </LinearLayout>

    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="6dp" android:paddingTop="8dp" android:text="@string/widget_empty"
        android:textSize="13sp" android:textColor="@color/widget_text_secondary" android:visibility="gone" />

    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/check1" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="7dp" android:src="@drawable/widget_ring" android:contentDescription="@string/widget_done" />
        <TextView android:id="@+id/text1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp"
            android:singleLine="true" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/time1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingEnd="6dp" android:textSize="12sp" android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/check2" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="7dp" android:src="@drawable/widget_ring" android:contentDescription="@string/widget_done" />
        <TextView android:id="@+id/text2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp"
            android:singleLine="true" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/time2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingEnd="6dp" android:textSize="12sp" android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/check3" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="7dp" android:src="@drawable/widget_ring" android:contentDescription="@string/widget_done" />
        <TextView android:id="@+id/text3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp"
            android:singleLine="true" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/time3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingEnd="6dp" android:textSize="12sp" android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/check4" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="7dp" android:src="@drawable/widget_ring" android:contentDescription="@string/widget_done" />
        <TextView android:id="@+id/text4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp"
            android:singleLine="true" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/time4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingEnd="6dp" android:textSize="12sp" android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/check5" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="7dp" android:src="@drawable/widget_ring" android:contentDescription="@string/widget_done" />
        <TextView android:id="@+id/text5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp"
            android:singleLine="true" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/time5" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingEnd="6dp" android:textSize="12sp" android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="34dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/check6" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="7dp" android:src="@drawable/widget_ring" android:contentDescription="@string/widget_done" />
        <TextView android:id="@+id/text6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp"
            android:singleLine="true" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/time6" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingEnd="6dp" android:textSize="12sp" android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="6dp" android:paddingTop="2dp" android:textSize="12sp"
        android:textColor="@color/widget_text_secondary" android:visibility="gone" />
</LinearLayout>
