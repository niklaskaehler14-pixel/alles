<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lang auf das App-Icon drücken → "Sprechen". Google Assistant: "Hey Google, Sprechen in Sprachliste" -->
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="de.sprachliste.action.VOICE"
            android:targetPackage="de.sprachliste"
            android:targetClass="de.sprachliste.MainActivity" />
    </shortcut>

    <!-- Google Assistant App Actions: "Hey Google, erstelle in Sprachliste: duschen gehen" -->
    <capability android:name="actions.intent.CREATE_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="de.sprachliste"
            android:targetClass="de.sprachliste.MainActivity">
            <url-template android:value="sprachliste://add{?text}" />
            <parameter android:name="thing.name" android:key="text" />
        </intent>
    </capability>
</shortcuts>
